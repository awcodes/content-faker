{
    "name": "awcodes/content-faker",
    "description": "Generate fake Markdown, HTML, and rich editor content for Laravel factories, seeders, tests, and previews.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.23",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Awcodes\\ContentFaker\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Awcodes\\ContentFaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Awcodes\\ContentFaker\\ContentFakerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "format": "pint",
        "lint": "pint --test",
        "rector": "rector process",
        "rector:dry": "rector process --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
